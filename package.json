{
  "name": "automationexercise-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Tests UI Playwright en TypeScript pour Automation Exercise",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
